# ─────────────────────────────────────────────────────────
# NutriGuide — IBM Granite AI Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your IBM watsonx.ai credentials.
# Get them at: https://cloud.ibm.com/iam/apikeys
# Project ID:  https://dataplatform.cloud.ibm.com/projects

WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_project_id_here
