# ─────────────────────────────────────────────
# NutriGuide AI — .gitignore
# ─────────────────────────────────────────────

# ── Secrets & credentials ────────────────────
.env
*.env
.env.local
.env.*.local

# ── Python virtual environments ──────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python cache & bytecode ──────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Distribution / packaging ─────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
*.whl
MANIFEST

# ── Generated nutrition plans (user data — runtime output) ──
plans/*.md
# Keep the plans/ directory itself tracked via .gitkeep
!plans/.gitkeep

# ── Testing ──────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.log

# ── IDEs & editors ───────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ── Jupyter Notebooks ────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS generated ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ── Type checking ─────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Installer logs ───────────────────────────
pip-*.txt
